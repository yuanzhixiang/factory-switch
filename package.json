{
  "name": "factory-switch",
  "version": "0.0.3",
  "private": true,
  "description": "在本机备份并切换 Factory 登录账号",
  "type": "module",
  "main": "out/main/index.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "pnpm typecheck && pnpm build:main && pnpm build:renderer",
    "start": "pnpm build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "dist": "pnpm build && electron-builder --mac --dir",
    "dist:release": "pnpm build && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "build": {
    "appId": "com.yuanzhixiang.factory-switch",
    "productName": "Factory Switch",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "artifactName": "Factory-Switch-${version}-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
